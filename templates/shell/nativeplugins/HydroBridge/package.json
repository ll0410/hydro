{
  "name": "HydroBridge",
  "id": "HydroBridge",
  "version": "0.1.0",
  "description": "Hydro 双通道 JSBridge 原生插件（Android addJavascriptInterface / iOS WKScriptMessageHandler）",
  "_dp_type": "nativeplugin",
  "_dp_nativeplugin": {
    "android": {
      "plugins": [
        {
          "type": "module",
          "name": "HydroBridge",
          "class": "com.hydro.bridge.HydroBridgeModule"
        }
      ],
      "integrateType": "source",
      "minSdkVersion": 21
    },
    "ios": {
      "plugins": [
        {
          "type": "module",
          "name": "HydroBridge",
          "class": "HydroBridgeModule"
        }
      ],
      "integrateType": "source",
      "deploymentTarget": "12.0"
    }
  }
}
